<%- include('includes/head') %>
<%- include('includes/nav') %>
 <div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="text-center">Sign In or Sign up</h1>
            <p class="text-center lead">Log in to your account or create a new one.</p>

            <%- include('includes/messages') %>

            <div class="row d-flex">
                 <div class="col-lg d-flex flex-column">
                    <h4>Sign up</h4>
                    <p>If you don't have an account yet, please fill out the form below.</p>
                    <form action="/login/register" method="POST" class="d-grid gap-3 mt-auto">
                        <input type="hidden" name="_csrf" value=<%= csrfToken %>>
                        <div class="form-group">
                          <label>Your Email:</label>
                          <input type="email" class="form-control" name="email">
                        </div>
                        <div class="form-group">
                          <label>Your Password:</label>
                          <input type="password" class="form-control" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Create Account</button>
                    </form>
                </div>
                 <div class="col-lg d-flex flex-column">
                    <h4>Sign in</h4>
                    <p> If you already have an account, enter your details below to log in.</p>
                    <form action="/login" method="POST" class="d-grid gap-3 mt-auto">
                        <input type="hidden" name="_csrf" value=<%= csrfToken %>>
                        <div class="form-group">
                          <label>Email:</label>
                          <input type="email" class="form-control" name="email">
                        </div>
                        <div class="form-group">
                          <label>Password:</label>
                          <input type="password" class="form-control" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Sign in</button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-2"></div>
    </div>
 </div>
<%- include('includes/footer') %>
    